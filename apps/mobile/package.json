    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "^58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-video": "^58.0.13",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^0.475.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
