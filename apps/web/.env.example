# Supabase project (Settings -> API). The anon/publishable key is safe in the browser
# because every table is protected by RLS. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# Public origin of this deployment (used in auth email links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
