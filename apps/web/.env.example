# Supabase project (Settings -> API). The anon/publishable key is safe in the browser
# because every table is protected by RLS. NEVER put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# Public origin of this deployment (used in auth email links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Error monitoring (optional). Leave empty to send nothing. The DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for readable stack traces. Set these in the host's build settings, never in the app.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Browser tests (optional). A test account on a non-production project; the signed-in tests only read.
# E2E_EMAIL=
# E2E_PASSWORD=
