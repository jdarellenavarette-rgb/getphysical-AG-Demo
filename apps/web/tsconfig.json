{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "sodia-core": [
        "../../packages/sodia-core/src/index.ts"
      ],
      "sodia-core/*": [
        "../../packages/sodia-core/src/*"
      ],
      "zod": [
        "../../packages/sodia-core/node_modules/zod"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
