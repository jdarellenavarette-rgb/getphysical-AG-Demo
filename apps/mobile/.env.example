# Supabase project (Settings -> API). Anon/publishable key only — never service_role.
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# Geoapify map tiles. Tile keys are visible to users by design: restrict this key to
# your app bundle IDs / referrers in the Geoapify dashboard.
EXPO_PUBLIC_MAPS_API_KEY="<geoapify-key>"
