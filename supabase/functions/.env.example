# Edge function secrets. Local: `supabase functions serve --env-file supabase/functions/.env`
# Production: `supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Comma-separated browser origins allowed to call the functions (mobile apps need none).
ALLOWED_ORIGINS="http://localhost:3000"

# nutrition-parse
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
NUTRITION_DAILY_LIMIT="50"

# payments-checkout: where providers send the buyer after paying.
CHECKOUT_REDIRECT_BASE_URL="https://app.getphysical.example"

# Xendit xenPlatform (COMMERCIAL gyms)
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
XENDIT_FEE_RULE_ONE_TIME=""   # fee rule: fixed PHP 15
XENDIT_FEE_RULE_RECURRING=""  # fee rule: 5%

# Stripe Connect (COMMUNITY clubs / coaches)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Maya Checkout (current test provider). Sandbox keys from Maya Manager / developer portal.
MAYA_API_BASE_URL="https://pg-sandbox.paymaya.com"
MAYA_PUBLIC_KEY=""
MAYA_SECRET_KEY=""
# Random string you choose; append ?token=<value> to the webhook URL registered with Maya.
MAYA_WEBHOOK_TOKEN=""
